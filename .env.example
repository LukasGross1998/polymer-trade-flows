# Copy this file to .env and fill in your values: cp .env.example .env
# .env is git-ignored. Never commit real keys.

# --- API keys (all optional; see README "Data sources and keys") ----------------------------
# UN Comtrade: not needed, the legacy check uses the public endpoint (ADR-003, ADR-009).
COMTRADE_API_KEY=
# AISStream.io live AIS WebSocket: free account; planned for the hosting phase, not used yet.
AISSTREAM_API_KEY=
# U.S. EIA Open Data: free registration; candidate source (crude stocks, ethane), not used yet.
EIA_API_KEY=

# Root folder of the local data lake (raw/clean/model layers)
DATA_DIR=data

# Folder with YAML configuration (regions, pipeline parameters)
CONFIG_DIR=config

# Dash app address. Default 127.0.0.1:8050 (this machine only); the Docker image uses 0.0.0.0.
# APP_HOST=127.0.0.1
# APP_PORT=8050
